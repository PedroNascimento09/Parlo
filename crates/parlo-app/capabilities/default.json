{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island-drag",
  "description": "The dictation island can be moved, grown for the language menu, and hidden once it has written, from the pages the engine serves on loopback.",
  "windows": ["island"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
